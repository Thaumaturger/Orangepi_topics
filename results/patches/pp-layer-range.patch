+int llama_model_loader::skip_tensors_with_prefix(const std::string & prefix) {
+    int n_skipped = 0;
+    for (const auto & it : weights_map) {
+        if (it.first.compare(0, prefix.size(), prefix) == 0) {
+            // note: size_data may temporarily wrap below zero; init_mappings() adds the file total afterwards
+            size_data -= ggml_nbytes(it.second.tensor);
